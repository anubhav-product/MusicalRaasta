# Optional. Without it the player streams 30-second previews from the public iTunes API.
#
# With it, listeners can sign in to their own Apple Music account and hear FULL songs
# through MusicKit JS. To generate one you need a paid Apple Developer account:
#   1. Certificates, Identifiers & Profiles -> Keys -> new key with "MusicKit" enabled.
#   2. Download the .p8 private key; note its Key ID and your 10-character Team ID.
#   3. Sign an ES256 JWT: issuer = Team ID, kid = Key ID, exp <= 180 days out.
#      e.g. `npx musickit-token-generator` or Apple's documented jwt snippet.
#
# The token is public by design (it ships to the browser) but expires, so rotate it.
VITE_MUSICKIT_TOKEN=

# YouTube Data API key — only used locally by scripts/resolve-youtube.mjs.
# Never needed at runtime: resolved video ids are baked into src/data/*-songs.json.
YOUTUBE_API_KEY=
